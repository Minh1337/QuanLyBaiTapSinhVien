<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvTenBaiTapTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nộp đồ án Android Cuối kỳ"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMoTaTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mô tả nội dung bài tập do giáo viên giao"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvHanNopTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Hạn nộp: 2025-03-15 23:59"
        android:textColor="@color/error_red"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Action buttons: Sửa bài & Thu hồi bài -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSuaBaiTeacher"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_demo"
            android:text="Sửa bài"
            android:textAllCaps="false"
            android:textColor="@color/purple_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnThuHoiBaiTeacher"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_demo"
            android:text="Thu hồi bài"
            android:textAllCaps="false"
            android:textColor="@color/error_red"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
