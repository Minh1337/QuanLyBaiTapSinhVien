<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".HomeActivity">

    <!-- Header phần trên: Logo HNUE ở góc trên bên trái -->
    <ImageView
        android:id="@+id/ivLogoApp"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Logo HNUE"
        android:src="@drawable/ic_logo_hnue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề lớn Trang chủ -->
    <TextView
        android:id="@+id/tvTitleTrangChu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="Trang chủ"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoApp" />

    <!-- Phần nội dung trung tâm (Để trống theo thiết kế) -->
    <FrameLayout
        android:id="@+id/layoutNoiDungChinh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutThanhBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleTrangChu" />

    <!-- Thanh điều hướng dưới cùng (Bottom Navigation) với 4 ô -->
    <LinearLayout
        android:id="@+id/layoutThanhBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Ô 1 (Trống) -->
        <LinearLayout
            android:id="@+id/tabOTrong1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- Đường vạch ngăn cách -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/input_border" />

        <!-- Ô 2 (Trống) -->
        <LinearLayout
            android:id="@+id/tabOTrong2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- Đường vạch ngăn cách -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/input_border" />

        <!-- Ô 3 (Trống) -->
        <LinearLayout
            android:id="@+id/tabOTrong3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" />

        <!-- Đường vạch ngăn cách -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/input_border" />

        <!-- Ô 4: Profile (Icon + Chữ Profile) -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="@color/blue_primary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
