<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF5FA"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#713E87"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Quay lại"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="THÊM/SỬA BÀI TẬP"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_delete_task"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Xóa bài tập"
            android:visibility="gone"
            app:tint="#FFCDD2" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Read-only Banner for Teacher Tasks -->
            <TextView
                android:id="@+id/tv_read_only_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF3E0"
                android:padding="12dp"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="🔒 Bài do Giáo viên giao: Tên bài, yêu cầu và hạn nộp chỉ được đọc."
                android:visibility="gone" />

            <!-- Title -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_title"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Tên bài tập cá nhân"
                app:boxStrokeColor="#713E87"
                app:hintTextColor="#713E87">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Subject Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Môn học / Lớp học:"
                android:textColor="#382841"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_subject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- Task Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Loại bài tập:"
                android:textColor="#382841"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/sp_task_type"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- Attach File Section -->
            <LinearLayout
                android:id="@+id/layout_attach_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_attach_file"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📎 File tài liệu bất kỳ"
                    android:textColor="#713E87"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_attached_file"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Chưa đính kèm"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Passing Score Threshold -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_passing_score"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="🎯 Mức điểm trắc nghiệm cần đạt (VD: 5.0 / 0 = Không yêu cầu)"
                app:boxStrokeColor="#713E87"
                app:hintTextColor="#713E87">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_passing_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Checkbox: Yêu cầu nộp file/ảnh bài làm -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_requires_submission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📁 Yêu cầu sinh viên nộp file / ảnh bài làm"
                android:textColor="#382841"
                android:textSize="13sp"
                android:textStyle="bold"
                android:checked="true" />

            <!-- Attach Quiz File Section -->
            <LinearLayout
                android:id="@+id/layout_attach_quiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_attach_quiz"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📥 Import câu hỏi Trắc nghiệm"
                    android:textColor="#713E87"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_attached_quiz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Chưa import (.txt / .docx)"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_download_quiz_template"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="📥 Tải mẫu file văn bản câu hỏi (.txt)"
                android:textColor="#713E87"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Container for rendered imported quiz questions with RadioGroups -->
            <LinearLayout
                android:id="@+id/layout_imported_quiz_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Description / Requirement -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_desc"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Yêu cầu / Mô tả chi tiết bài tập"
                app:boxStrokeColor="#713E87"
                app:hintTextColor="#713E87">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_task_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Due Date Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_due_date"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Hạn nộp (YYYY-MM-DD HH:mm)"
                    app:boxStrokeColor="#713E87"
                    app:hintTextColor="#713E87">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_due_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_pick_date"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Chọn hạn"
                    android:textColor="#713E87" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0D0E0" />

            <!-- Student Options: Priority & Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIẾN ĐỘ &amp; ƯU TIÊN CỦA SINH VIÊN"
                android:textColor="#713E87"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mức ưu tiên:"
                        android:textColor="#382841"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_priority"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trạng thái:"
                        android:textColor="#382841"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_status"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>

            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#713E87"
                android:text="LƯU BÀI TẬP"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
