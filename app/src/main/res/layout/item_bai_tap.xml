<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Row 1: Badges & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tag Nguồn bài -->
        <TextView
            android:id="@+id/tvTagNguon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_teacher"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Giáo viên giao"
            android:textColor="@color/purple_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Tag Quá hạn -->
        <TextView
            android:id="@+id/tvTagQuaHan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_overdue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Quá hạn"
            android:textColor="@color/badge_overdue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Trạng thái -->
        <TextView
            android:id="@+id/tvTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Đang làm"
            android:textColor="@color/purple_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tên bài tập -->
    <TextView
        android:id="@+id/tvTenBaiTap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tên bài tập"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Lớp / Môn học -->
    <TextView
        android:id="@+id/tvNguon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Lập trình Android MOB01"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Hạn nộp & Tiến độ % -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHanNop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hạn nộp: 2025-03-15 23:59"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="@color/purple_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progress="50"
        android:progressDrawable="@drawable/bg_purple_button" />

</LinearLayout>
