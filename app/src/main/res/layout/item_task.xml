<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0D0E0"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Source Tag & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Source Tag (Cá nhân / Giáo viên giao) -->
            <TextView
                android:id="@+id/tv_source_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#713E87"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Cá nhân"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subject_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Lập trình Android MOB01"
                android:textColor="#666666"
                android:textSize="12sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Priority Chip -->
            <TextView
                android:id="@+id/tv_priority_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F6DFEC"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Ưu tiên: Cao"
                android:textColor="#713E87"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Task Title -->
        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nộp đồ án Android Cuối kỳ"
            android:textColor="#382841"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Description Snippet -->
        <TextView
            android:id="@+id/tv_task_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Xây dựng ứng dụng Sổ bài tập sinh viên..."
            android:textColor="#555555"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Due Date & Status Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_due_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏰ Hạn nộp: 2025-05-30 23:59"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E0E0E0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Chưa làm"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Checklist Progress Bar -->
        <LinearLayout
            android:id="@+id/layout_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/pb_checklist"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#713E87" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="50%"
                android:textColor="#713E87"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
